node_modules/
.next/
.env.local
.env*.local

# ── Ficheros de herramientas y temporales ──────────────────────────────
# Worktrees que crea Claude Code. Cada uno es un repositorio git completo dentro de este, así que git
# los ve como submódulos y cualquier `git add -A` los mete como gitlinks que luego nadie puede clonar.
.claude/worktrees/

# Permisos locales de Claude Code. Son de ESTA máquina: llevan rutas absolutas con el nombre de
# usuario y la lista de comandos que se aprobaron aquí, que no le sirve de nada a nadie más. ESTE
# REPOSITORIO ES PÚBLICO. El fichero estuvo versionado hasta V9.879; sacarlo del índice no lo quita
# del historial, y no se reescribe el historial a propósito, así que las 177 reglas que llegaron a
# publicarse siguen siendo visibles ahí. No había ninguna clave ni token dentro.
# .claude/launch.json SÍ se versiona: define cómo arrancar el dev server y es igual para todos.
.claude/settings.local.json

# Enlace del proyecto con Vercel (README.txt + repo.json). Lo genera la CLI y es local de la máquina.
.vercel/

# Logs: dev-server.log y cualquier otro que deje una herramienta.
*.log

# Copias de seguridad locales. backups/strategies/ contiene el code_js completo de todas las
# estrategias: la lógica entera de la aplicación. ESTE REPOSITORIO ES PÚBLICO, así que el volcado no
# sale de tu disco. La regla va antes que el script que lo genera, a propósito.
backups/

# Volcado de logs de despliegue de Vercel guardado con un nombre corrupto: la ruta de Windows
# "C:\Temp\vl.json" acabó como nombre de fichero, con el ':' convertido en U+F03A. El patrón lleva un
# comodín porque ese carácter no es tecleable.
C*Tempvl.json
